# AI-Live environment variables

# Required for Azure OpenAI manual analysis with gpt-5.5.
AZURE_OPENAI_ANALYSIS_API_KEY=your_gpt_5_5_api_key_here
AZURE_OPENAI_ANALYSIS_ENDPOINT=https://your-gpt-5-5-resource.openai.azure.com

# Required for direct desktop-audio Realtime answering.
# These do not fall back to the analysis or legacy transcription credentials.
AZURE_OPENAI_REALTIME_API_KEY=your_realtime_resource_api_key_here
AZURE_OPENAI_REALTIME_ENDPOINT=https://your-realtime-resource.openai.azure.com
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini

# Optional manual-analysis deployment override and shared fallback.
#AZURE_OPENAI_ANALYSIS_DEPLOYMENT=gpt-5.5
#AZURE_OPENAI_API_KEY=your_shared_analysis_api_key_here
#AZURE_OPENAI_ENDPOINT=https://your-shared-analysis-resource.openai.azure.com

# Optional audio configuration. Realtime input is normalized to 24000 Hz mono PCM.
#SAMPLE_RATE=24000
#CHANNELS=1
#CHUNK_SIZE=1024

# Optional server VAD latency tuning.
#AZURE_OPENAI_VAD_SILENCE_MS=350
#AZURE_OPENAI_VAD_THRESHOLD=0.5
#AZURE_OPENAI_VAD_PREFIX_PADDING_MS=300
#AUTO_ANSWER_LATENCY_LOG=false

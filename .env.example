# OpenAI API key for manual analysis and Realtime answering.
OPENAI_API_KEY=your_openai_api_key_here

# Optional model overrides.
#OPENAI_ANALYSIS_MODEL=gpt-5.5
#OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Optional audio configuration. Realtime input is normalized to 24000 Hz mono PCM.
#SAMPLE_RATE=24000
#CHANNELS=1
#CHUNK_SIZE=1024

# Optional server VAD latency tuning.
#OPENAI_VAD_SILENCE_MS=350
#OPENAI_VAD_THRESHOLD=0.5
#OPENAI_VAD_PREFIX_PADDING_MS=300
#AUTO_ANSWER_LATENCY_LOG=false

# Realtime model diagnostics: requests, completed output/tool arguments, status,
# usage, speech boundaries, and errors. Enabled by default; logs answer content.
#OPENAI_REALTIME_MODEL_LOG=true
